#!/usr/bin/env bash
# secret-scan — refuse to let credentials into the backup.
#
#   scripts/secret-scan            scan the working tree (claude/, codex/)
#   scripts/secret-scan --staged   scan what is staged for the next commit
#
# Exits 1 and prints file:line for every hit. A known-safe line is allowed by
# adding "path-regex<TAB>line-regex  # reason" to scripts/secret-scan.allow.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

PATTERNS=(
  'gh[pousr]_[A-Za-z0-9]{30,}'                 # GitHub tokens
  'github_pat_[A-Za-z0-9_]{40,}'
  'sk-ant-[A-Za-z0-9_-]{20,}'                  # Anthropic
  'sk-(proj-)?[A-Za-z0-9]{32,}'                # OpenAI
  'AKIA[0-9A-Z]{16}'                           # AWS access key
  'AIza[0-9A-Za-z_-]{35}'                      # Google API key
  'xox[abposr]-[A-Za-z0-9-]{10,}'              # Slack
  'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}' # JWT (Supabase keys)
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '"(access|refresh)_?[Tt]oken"[[:space:]]*:[[:space:]]*"[^"]{16,}"'
  '(password|passwd|secret|api_?key)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_.-]{16,}'
)

if [ "${1:-}" = "--staged" ]; then
  mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
  show() { git show ":$1"; }
else
  mapfile -t files < <(git ls-files -co --exclude-standard claude codex)
  show() { cat "$1"; }
fi

allowed() { # file line -> 0 when an allow rule covers it
  local pf pl
  [ -f scripts/secret-scan.allow ] || return 1
  while IFS=$'\t' read -r pf pl; do
    pl=${pl%%  #*}
    [[ "$1" =~ $pf ]] && [[ "$2" =~ $pl ]] && return 0
  done < <(grep -v '^[[:space:]]*\(#\|$\)' scripts/secret-scan.allow)
  return 1
}

hits=0
for f in "${files[@]}"; do
  [ -L "$f" ] && continue
  for p in "${PATTERNS[@]}"; do
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      allowed "$f" "${line#*:}" && continue
      echo "SECRET? $f:${line%%:*}"
      hits=1
    done < <(show "$f" 2>/dev/null | grep -nIE -e "$p" | cut -c1-200)
  done
done

[ "$hits" = 0 ] && echo "secret-scan: clean (${#files[@]} files)"
exit "$hits"
