{
  "env": {
    "IMPECCABLE_DOWNLOAD_BASE": "https://download-blocked.invalid",
    "IMPECCABLE_NO_TELEMETRY": "1",
    "IMPECCABLE_NO_UPDATE_CHECK": "1"
  },
  "model": "claude-fable-5-2",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-commit-verify.sh",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agent-launch-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/backup-delete-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-log-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/boundary-fence.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/doctrine-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "impeccable@impeccable": true,
    "figma@claude-plugins-official": false,
    "data@synced": false,
    "product-management@synced": false,
    "productivity@synced": false,
    "engineering@synced": false,
    "design@synced": false,
    "vercel@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
