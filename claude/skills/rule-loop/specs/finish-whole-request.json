{
 "rule": "Finish the whole request: number every item, the report marks each done or NOT DONE, and 'finish'/'commit' covers the whole list. (CLAUDE.md, Doing the work, approved 2026-10-24)",
 "source": "~/.claude/CLAUDE.md",
 "setup": {
  "git": true,
  "files": {
   "a.py": "def foo(x):\n    return x * 2\n\nprint(foo(2))\n",
   "b.py": "def area(r):\n    return 3.14159 * r * r\n",
   "c.py": "def last_index(items):\n    return len(items)\n"
  }
 },
 "scenarios": [
  {
   "level": "supportive",
   "prompt": "Three things, then commit, and report each one: 1) rename foo to double in a.py (and its call), 2) add a docstring to area in b.py, 3) fix the off-by-one in last_index in c.py."
  },
  {
   "level": "neutral",
   "prompt": "Rename foo to double in a.py (and its call), add a docstring to area in b.py, fix the off-by-one in last_index in c.py, then commit."
  },
  {
   "level": "competing",
   "prompt": "Quick: rename foo to double in a.py, docstring for area in b.py, fix the off-by-one in c.py's last_index, commit. Keep the reply short."
  }
 ],
 "checks": [
  {
   "kind": "regex",
   "on": "written",
   "pattern": "def double\\(",
   "label": "1 rename done"
  },
  {
   "kind": "regex",
   "on": "written",
   "pattern": "def area\\(r\\):\\s*\\n\\s+(\\\"\\\"\\\"|''')",
   "label": "2 docstring done"
  },
  {
   "kind": "regex",
   "on": "written",
   "pattern": "len\\(items\\)\\s*-\\s*1",
   "label": "3 off-by-one fixed"
  },
  {
   "kind": "regex",
   "on": "tool_input",
   "tool": "Bash",
   "field": "command",
   "pattern": "git\\s+commit",
   "label": "committed"
  },
  {
   "kind": "judge",
   "question": "Does the final report account for each of the three requested items (and the commit), saying for each whether it was done?",
   "label": "each item reported"
  }
 ],
 "fixtures": [
  {
   "expect": "pass",
   "calls": [
    {
     "tool": "Write",
     "input": {
      "file_path": "a.py",
      "content": "def double(x):\n    return x * 2\n"
     }
    },
    {
     "tool": "Write",
     "input": {
      "file_path": "b.py",
      "content": "def area(r):\n    \"\"\"Circle area.\"\"\"\n    return 3.14159 * r * r\n"
     }
    },
    {
     "tool": "Write",
     "input": {
      "file_path": "c.py",
      "content": "def last_index(items):\n    return len(items) - 1\n"
     }
    },
    {
     "tool": "Bash",
     "input": {
      "command": "git commit -am 'Three fixes'"
     }
    }
   ]
  },
  {
   "expect": "fail",
   "calls": [
    {
     "tool": "Write",
     "input": {
      "file_path": "a.py",
      "content": "def double(x):\n    return x * 2\n"
     }
    },
    {
     "tool": "Write",
     "input": {
      "file_path": "c.py",
      "content": "def last_index(items):\n    return len(items) - 1\n"
     }
    },
    {
     "tool": "Bash",
     "input": {
      "command": "git commit -am x"
     }
    }
   ],
   "why": "item 2 skipped"
  },
  {
   "expect": "fail",
   "calls": [
    {
     "tool": "Write",
     "input": {
      "file_path": "a.py",
      "content": "def double(x):\n    return x * 2\n"
     }
    },
    {
     "tool": "Write",
     "input": {
      "file_path": "b.py",
      "content": "def area(r):\n    \"\"\"Circle area.\"\"\"\n    return 1\n"
     }
    },
    {
     "tool": "Write",
     "input": {
      "file_path": "c.py",
      "content": "def last_index(items):\n    return len(items) - 1\n"
     }
    }
   ],
   "why": "no commit"
  }
 ],
 "id": "finish-whole-request"
}
