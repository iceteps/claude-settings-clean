#!/usr/bin/env python3
"""Delete backups only after proving another copy holds the same bytes.

  backup-retire PATH... --in REPO [--in REPO ...]   a commit in REPO must hold each file
  backup-retire PATH... --same-as COPY              COPY must be byte-identical (one file)
  backup-retire PATH... --discard "REASON"          no copy; the owner approved losing these

The proof runs first for every file, and one unproven file deletes nothing. Directories are
walked. Each completed deletion is logged to ~/.claude/state/backup-retire.log; exit 1 if any failed.
The backup-delete-guard hook sends every agent deletion of a backup through here.
"""
import argparse
import datetime
import filecmp
import os
import stat
import subprocess
import sys

LOG = os.path.expanduser("~/.claude/state/backup-retire.log")


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def committed_in(path, repos):
    for repo in repos:
        blob = subprocess.run(["git", "hash-object", path], capture_output=True, text=True, check=True).stdout.strip()
        found = git(repo, "log", "--all", "--format=%h", "-1", f"--find-object={blob}")
        if found.returncode == 0 and found.stdout.strip():
            return f"{os.path.basename(repo.rstrip('/'))}@{found.stdout.strip()} blob {blob[:12]}"
    return None


def record(path, proof):
    now = datetime.datetime.now().isoformat(timespec="seconds")
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as log:
            log.write(f"{now}\t{os.path.abspath(path)}\t{proof}\n")
    except OSError as error:
        # The proof is what protects the data; the printed lines still record it.
        print(f"backup-retire: could not write the log: {error}", file=sys.stderr)


def files_under(paths):
    for path in paths:
        if os.path.isdir(path) and not os.path.islink(path):
            for root, _, names in os.walk(path):
                for name in sorted(names):
                    yield os.path.join(root, name)
        else:
            yield path


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("paths", nargs="+")
    parser.add_argument("--in", dest="repos", action="append", default=[], metavar="REPO")
    parser.add_argument("--same-as", metavar="COPY")
    parser.add_argument("--discard", metavar="REASON")
    args = parser.parse_args()

    if sum(map(bool, (args.repos, args.same_as, args.discard))) != 1:
        parser.error("give exactly one proof: --in, --same-as or --discard")
    missing = [p for p in args.paths if not os.path.lexists(p)]
    if missing:
        sys.exit(f"backup-retire: not found, nothing deleted: {missing}")

    proven, unproven = [], []
    for path in files_under(args.paths):
        if args.discard:
            proven.append((path, f"discarded: {args.discard}"))
        elif args.same_as:
            same = os.path.isfile(args.same_as) and filecmp.cmp(path, args.same_as, shallow=False)
            (proven.append((path, f"identical to {args.same_as}")) if same else unproven.append(path))
        else:
            proof = committed_in(path, args.repos)
            (proven.append((path, proof)) if proof else unproven.append(path))

    for path, proof in proven:
        print(f"proven   {path}  <- {proof}")
    if unproven:
        for path in unproven:
            print(f"UNPROVEN {path}")
        sys.exit("backup-retire: no matching copy for the files above; nothing deleted.")

    # Snapshots are often read-only on purpose. The proof above is the permission to remove them.
    failed = []
    for path, proof in proven:
        try:
            parent = os.path.dirname(os.path.abspath(path))
            os.chmod(parent, os.stat(parent).st_mode | stat.S_IRWXU)
            os.remove(path)
        except OSError as error:
            failed.append(f"{path}: {error}")
            continue
        record(path, proof)
    for path in args.paths:
        if os.path.isdir(path) and not os.path.islink(path) and not failed:
            folders = [path]
            for root, names, _ in os.walk(path):
                os.chmod(root, os.stat(root).st_mode | stat.S_IRWXU)
                folders += [os.path.join(root, name) for name in names]
            for folder in reversed(folders):
                os.rmdir(folder)
    print(f"deleted  {len(proven) - len(failed)} of {len(proven)} file(s)")
    if failed:
        sys.exit("backup-retire: could not delete:\n  " + "\n  ".join(failed))


if __name__ == "__main__":
    main()
